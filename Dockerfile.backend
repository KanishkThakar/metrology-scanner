FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend /app/backend
COPY FRONTEND /app/FRONTEND
RUN mkdir -p /data
ENV METROLOGY_DATA_DIR=/data PYTHONUNBUFFERED=1
EXPOSE 10000
CMD ["sh", "-c", "cd /app/backend && exec python -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-10000}"]
