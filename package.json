{
  "name": "metrology-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @metrology/web --",
    "build": "npm run build --workspace @metrology/web",
    "start": "npm run start --workspace @metrology/web --",
    "mobile": "npm run start --workspace @metrology/mobile --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:ocr-ui": "playwright test --config playwright.ocr-ui.config.ts",
    "test:ocr-reference": "playwright test tests/ocr-engine-choice.spec.ts",
    "api": ".venv/bin/python scripts/run-api.py",
    "test:web": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}

